# ===========================================================================
# SoftMyMarket — Apache configuration for shared hosting (aeonfree / hstn.me)
# ===========================================================================
# This file is deliberately conservative: every block is wrapped in an
# <IfModule> test so a host without that module (or with a restricted
# AllowOverride) does not return "500 Internal Server Error".

DirectoryIndex index.php index.html

# -Indexes stops directory listings. If the host rejects the Options directive
# it will show a 500 error on every page — in that case comment out the two
# lines below (the app itself never needs them).
<IfModule mod_autoindex.c>
    Options -Indexes
</IfModule>

# ---------------------------------------------------------------------------
# HTTPS
# ---------------------------------------------------------------------------
# aeonfree issues a free certificate for *.hstn.me. Once it is active, uncomment
# the three lines below to force HTTPS everywhere.
#<IfModule mod_rewrite.c>
#    RewriteEngine On
#    RewriteCond %{HTTPS} !=on
#    RewriteCond %{HTTP:X-Forwarded-Proto} !https
#    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
#</IfModule>

# Optional pretty URLs (the app works fine with .php URLs out of the box).
#<IfModule mod_rewrite.c>
#    RewriteEngine On
#    RewriteRule ^p/([a-z0-9-]+)/?$ product.php?slug=$1 [L,QSA]
#    RewriteRule ^c/([a-z0-9-]+)/?$ category.php?slug=$1 [L,QSA]
#</IfModule>

# ---------------------------------------------------------------------------
# Never serve application internals
# ---------------------------------------------------------------------------
<IfModule mod_alias.c>
    RedirectMatch 404 ^/(config|includes|database|storage|tests|docs)(/|$)
    RedirectMatch 404 ^/(tools|install)/.*\.(php|md|sql|lock)$
    RedirectMatch 404 /\.(git|env|htaccess|htpasswd|editorconfig)(/|$)
    RedirectMatch 404 /(README|DEPLOYMENT|SECURITY|CHANGELOG|AEONFREE)\.md$
</IfModule>

<FilesMatch "\.(sql|sql\.gz|log|lock|ini|dist|bak|sh|md|json|yml|yaml)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# ---------------------------------------------------------------------------
# Security headers
# ---------------------------------------------------------------------------
<IfModule mod_headers.c>
    Header always unset X-Powered-By
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(self)"
    Header always set Cross-Origin-Opener-Policy "same-origin"
    Header always set X-Permitted-Cross-Domain-Policies "none"
    # Enable only after HTTPS is confirmed working:
    # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

# ---------------------------------------------------------------------------
# PHP hardening for hosts that run PHP as an Apache module (mod_php).
# Under PHP-FPM/CGI these directives are ignored — .user.ini covers that case.
# ---------------------------------------------------------------------------
<IfModule mod_php.c>
    php_flag display_errors off
    php_flag log_errors on
    php_value session.cookie_httponly 1
    php_value session.cookie_samesite Lax
    php_value session.use_strict_mode 1
    php_value upload_max_filesize 6M
    php_value post_max_size 8M
</IfModule>
<IfModule mod_php7.c>
    php_flag display_errors off
    php_value upload_max_filesize 6M
    php_value post_max_size 8M
</IfModule>

# ---------------------------------------------------------------------------
# Compression + caching (both optional, both guarded)
# ---------------------------------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript
    AddOutputFilterByType DEFLATE application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 30 days"
    ExpiresByType application/javascript "access plus 30 days"
    ExpiresByType image/svg+xml "access plus 30 days"
    ExpiresByType image/webp "access plus 30 days"
    ExpiresByType image/jpeg "access plus 30 days"
    ExpiresByType image/png "access plus 30 days"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# ---------------------------------------------------------------------------
# Error pages (optional)
# ---------------------------------------------------------------------------
# ErrorDocument 404 /404.php
